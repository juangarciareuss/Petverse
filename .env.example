# Variables de entorno; el servidor NO carga este archivo automáticamente.
PORT=3000
HOST=0.0.0.0
DATABASE_PATH=data/petverse.sqlite
# PostgreSQL opcional. Cuando existe DATABASE_URL, se usa en lugar de SQLite.
# No guardar credenciales reales aquí: usar variables del hosting o un .env ignorado.
# DATABASE_URL=postgresql://localhost/petverse
# PETVERSE_TRIAL_MODE=render-free
# Laboratorio aislado para desarrollar sin esperar días. Desactivado por defecto.
# PETVERSE_DEVELOPER_TOOLS=true
# Fuera de Render: URL pública HTTPS exacta para validar Origin.
# En Render se usa automáticamente RENDER_EXTERNAL_URL si no se fija PUBLIC_ORIGIN.
# PUBLIC_ORIGIN=https://petverse.example.com
# NODE_ENV=production
